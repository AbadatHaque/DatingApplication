// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Gender {
  male             
  female           
}

enum AreaType {
  rural           
  urban            
}

enum OccupationType {
  salaried      
  selfEmployed   
  business         
  student          
  unemployed       
  retired          
}

enum MarriageTimeline {
  within1Year    
  oneToTwoYears 
  twoToFiveYears 
  notSure         
}
model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String?
  password        String   
  dob             DateTime
  requestsRecived requestConnection[] @relation("requestReceiver")
  requestsSend    requestConnection[] @relation("requestSender")

  gender Gender 
  lookingFor String @db.VarChar(500)
  about String @db.VarChar(500)
  areaType AreaType
  occupation     String?
  occupationType OccupationType?
  higherEducation String
  mobileNumber String
  marriageTimeline MarriageTimeline?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  state String?
  city String?
  address String?

}

enum Status {
  like     
  dislike  
  rejected 
  accepted 
}
model requestConnection {s
  id      Int  @id @default(autoincrement())
  fromId Int
  toId   Int
  from    User @relation("requestSender", fields: [fromId], references: [id])
  to      User @relation("requestReceiver", fields: [toId], references: [id])
  status Status
  @@unique([fromId,toId])
  @@index([fromId,status])
  @@index([toId,status])
}

