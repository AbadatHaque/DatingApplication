// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
enum AreaType {
  RURAL
  URBAN
}
enum OccupationType {
  SALARIED
  SELF_EMPLOYED
  BUSINESS
  STUDENT
  UNEMPLOYED
  RETIRED
}
enum MarriageTimeline {
  WITHIN_1_YEAR
  ONE_TO_TWO_YEARS
  TWO_TO_FIVE_YEARS
  NOT_SURE
}
model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String?
  password        String    @unique
  dob             DateTime
  requestsRecived Request[] @relation("requestReceiver")
  requestsSend    Request[] @relation("requestSender")

  gender Gender
  lookingFor String
  about String
  areaType AreaType
  occupation     String?
  occupationType OccupationType?
  higherEducation String
  mobileNumber String
  marriageTimeline MarriageTimeline?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  state String?
  city String?
  address String?

}

model Request {
  id      Int  @id @default(autoincrement())
  from_id Int
  to_id   Int
  from    User @relation("requestSender", fields: [from_id], references: [id])
  to      User @relation("requestReceiver", fields: [to_id], references: [id])
}
